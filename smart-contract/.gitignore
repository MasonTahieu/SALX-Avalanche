# Deploy records: keep the live Fuji deployment (addresses, journal, ABIs,
# build-info; all public on-chain) so it is backed up and verifiable.
# Other chains (local test runs) stay ignored.
ignition/deployments/*
!ignition/deployments/chain-43113/
# "artifacts/" above would also drop its deployed ABIs.
!ignition/deployments/chain-43113/artifacts/
.env
.env.*
!.env.example
