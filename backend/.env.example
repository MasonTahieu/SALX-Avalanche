PORT=5000
MONGODB_URI=mongodb://localhost:27018/carbon_project?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# Avalanche Fuji C-Chain testnet
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
BLOCK_EXPLORER_URL=https://testnet.snowtrace.io
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_SYNC_INTERVAL_MS=5000

# Địa chỉ và block deploy lấy từ smart-contract/ignition/deployments/chain-43113/
SAL_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=
GREEN_CERTIFICATE_SBT_ADDRESS=
SAL_DEPLOYMENT_BLOCK=
MARKETPLACE_DEPLOYMENT_BLOCK=
CERTIFICATE_DEPLOYMENT_BLOCK=

# IPFS: filebase (mặc định, gói Free 5 GB không cần thẻ) hoặc pinata
IPFS_PROVIDER=filebase
IPFS_GATEWAY_URL=https://ipfs.filebase.io/ipfs

# Filebase: tạo bucket mạng IPFS tại console.filebase.com, lấy key ở mục Access Keys
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=

# Pinata: chỉ cần khi IPFS_PROVIDER=pinata
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Khoá quản trị. Chỉ dùng ví testnet, không commit file .env thật.
ADMIN_SECRET_KEY=
ADMIN_PRIVATE_KEY=
METADATA_SIGNER_PRIVATE_KEY=
METADATA_SIGNATURE_TTL_SECONDS=900
VALIDATOR_PRIVATE_KEY=
